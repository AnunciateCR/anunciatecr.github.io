"""Crea las páginas para compartir cada negocio (vista previa bonita en WhatsApp, Facebook, etc.).
Lo ejecuta GitHub cada 30 minutos. Para cada negocio aprobado crea:
  n/<id>/index.html  -> página con la vista previa (y que lleva al perfil real)
  n/<id>/card.jpg    -> la etiqueta con la foto, el nombre, la categoría y la ubicación
"""
import os, io, re, sys, json, base64, hashlib, html, shutil, urllib.request
from PIL import Image, ImageDraw, ImageFont, ImageFilter

SITE = 'https://anunciatecr.com'
# Siempre en la raíz del repositorio, sin importar desde dónde se ejecute
ROOT = os.environ.get('GITHUB_WORKSPACE') or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, 'n')
NAVY, NAVY2, ORANGE, MUTED, LIGHT = (10, 19, 34), (22, 34, 58), (242, 105, 29), (148, 163, 184), (203, 213, 225)

def font(size, bold=True):
    names = (['Poppins-Bold.ttf', 'DejaVuSans-Bold.ttf', 'LiberationSans-Bold.ttf'] if bold
             else ['Poppins-Medium.ttf', 'DejaVuSans.ttf', 'LiberationSans-Regular.ttf'])
    for d in ['/usr/share/fonts/truetype/google-fonts/', '/usr/share/fonts/truetype/dejavu/', '/usr/share/fonts/truetype/liberation/', '']:
        for n in names:
            try: return ImageFont.truetype(d + n, size)
            except OSError: pass
    return ImageFont.load_default()

def background():
    img = Image.new('RGB', (1200, 630), NAVY)
    d = ImageDraw.Draw(img)
    for y in range(630):  # degradado vertical suave
        t = y / 630
        d.line([(0, y), (1200, y)], fill=tuple(int(NAVY2[i] * (1 - t) + NAVY[i] * t) for i in range(3)))
    glow = Image.new('RGB', (1200, 630), (0, 0, 0))
    ImageDraw.Draw(glow).ellipse([760, -260, 1380, 300], fill=(120, 50, 12))
    glow = glow.filter(ImageFilter.GaussianBlur(110))
    return Image.blend(img, Image.composite(glow, img, glow.convert('L')), 0.9)

def speaker(d, x, y, s, color=ORANGE):
    """Bocina del logo; (x,y) esquina superior izquierda, s = alto."""
    k = s / 24.0
    p = lambda a, b: (x + a * k, y + b * k)
    d.polygon([p(3, 10), p(3, 14), p(6, 15), p(12, 19), p(12, 5), p(6, 9)], fill=color)
    for r, (cx, sw) in ((4.5, (12, 2)), (8, (12, 2))):
        d.arc([x + (cx - r) * k, y + (12 - r) * k, x + (cx + r) * k, y + (12 + r) * k], -50, 50, fill=color, width=max(2, int(sw * k)))

def flag(d, x, y, w):
    h = int(w * 2 / 3)
    d.rounded_rectangle([x, y, x + w, y + h], radius=3, fill=(255, 255, 255))
    d.rectangle([x, y, x + w, y + h // 5], fill=(0, 43, 127))
    d.rectangle([x, y + h - h // 5, x + w, y + h], fill=(0, 43, 127))
    d.rectangle([x, y + int(h * .36), x + w, y + int(h * .64)], fill=(200, 16, 46))

def pill(d, xy, text, f, fill, color=(255, 255, 255), pad=22, h=52):
    x, y = xy
    w = int(d.textlength(text, font=f)) + pad * 2
    d.rounded_rectangle([x, y, x + w, y + h], radius=h // 2, fill=fill)
    d.text((x + pad, y + h / 2), text, font=f, fill=color, anchor='lm')
    return w

def wrap(d, text, f, maxw, maxlines=2):
    words, lines, cur = text.split(), [], ''
    for w in words:
        t = (cur + ' ' + w).strip()
        if d.textlength(t, font=f) <= maxw or not cur: cur = t
        else: lines.append(cur); cur = w
    lines.append(cur)
    if len(lines) > maxlines:
        lines = lines[:maxlines]; lines[-1] = lines[-1][:max(1, len(lines[-1]) - 3)].rstrip() + '…'
    return lines

def circle_photo(photo, size):
    im = Image.open(io.BytesIO(photo)).convert('RGB')
    w, h = im.size; m = min(w, h)
    im = im.crop(((w - m) // 2, (h - m) // 2, (w - m) // 2 + m, (h - m) // 2 + m)).resize((size, size), Image.LANCZOS)
    mask = Image.new('L', (size * 3, size * 3), 0)
    ImageDraw.Draw(mask).ellipse([0, 0, size * 3 - 1, size * 3 - 1], fill=255)
    out = Image.new('RGBA', (size, size)); out.paste(im, (0, 0), mask.resize((size, size), Image.LANCZOS))
    return out

def footer(img, d):
    speaker(d, 70, 548, 44); d.text((126, 570), 'AnunciateCR', font=font(34), fill=(255, 255, 255), anchor='lm')
    flag(d, 366, 558, 36)
    f = font(28); t = 'anunciatecr.com'; w = int(d.textlength(t, font=f)) + 48
    d.rounded_rectangle([1130 - w, 544, 1130, 596], radius=26, fill=ORANGE)
    d.text((1130 - w / 2, 570), t, font=f, fill=(255, 255, 255), anchor='mm')

def make_card(name, cat, loc, photo=None):
    img = background(); d = ImageDraw.Draw(img)
    S, X0, Y0 = 340, 70, 95
    d.ellipse([X0 - 9, Y0 - 9, X0 + S + 9, Y0 + S + 9], fill=ORANGE)
    if photo:
        try:
            img.paste(circle_photo(photo, S), (X0, Y0), circle_photo(photo, S)); photo_ok = True
        except Exception: photo_ok = False
    else: photo_ok = False
    if not photo_ok:
        d.ellipse([X0, Y0, X0 + S, Y0 + S], fill=(30, 41, 59))
        ini = ''.join(w[0] for w in re.findall(r'\w+', name)[:2]).upper() or 'A'
        d.text((X0 + S / 2, Y0 + S / 2), ini, font=font(120), fill=(255, 255, 255), anchor='mm')
    x = 470
    if cat: pill(d, (x, 100), cat.upper() if len(cat) < 16 else cat, font(26), ORANGE)
    size = 64
    while size > 38:
        f = font(size); lines = wrap(d, name, f, 660, 2)
        if all(d.textlength(l, font=f) <= 660 for l in lines) and not lines[-1].endswith('…'): break
        size -= 4
    f = font(size); lines = wrap(d, name, f, 660, 2); y = 190
    for l in lines: d.text((x, y), l, font=f, fill=(255, 255, 255)); y += int(size * 1.2)
    if loc:
        d.ellipse([x, y + 24, x + 20, y + 44], fill=ORANGE); d.ellipse([x + 7, y + 31, x + 13, y + 37], fill=NAVY)
        for l in wrap(d, loc, font(30, False), 600, 2):
            d.text((x + 34, y + 14), l, font=font(30, False), fill=LIGHT); y += 40
    footer(img, d)
    out = io.BytesIO(); img.save(out, 'JPEG', quality=86, optimize=True); return out.getvalue()

def make_site_card():
    img = background(); d = ImageDraw.Draw(img)
    f96 = font(96); speaker(d, 120, 150, 120); d.text((270, 215), 'AnunciateCR', font=f96, fill=(255, 255, 255), anchor='lm')
    flag(d, 270 + int(d.textlength('AnunciateCR', font=f96)) + 28, 190, 84)
    d.text((120, 340), 'La red social de negocios de Costa Rica', font=font(44, False), fill=LIGHT)
    d.text((120, 400), 'Descubre, sigue y contacta negocios ticos cerca de ti.', font=font(34, False), fill=MUTED)
    f = font(36); t = 'Explorar negocios'; w = int(d.textlength(t, font=f)) + 70
    d.rounded_rectangle([120, 480, 120 + w, 560], radius=40, fill=ORANGE); d.text((120 + w / 2, 520), t, font=f, fill=(255, 255, 255), anchor='mm')
    out = io.BytesIO(); img.save(out, 'JPEG', quality=88, optimize=True); return out.getvalue()

def get_photo(b):
    p = (b.get('photo') or '').strip()
    try:
        if p.startswith('data:'): return base64.b64decode(p.split(',', 1)[1])
        if p.startswith('https://'):
            with urllib.request.urlopen(urllib.request.Request(p, headers={'User-Agent': 'AnunciateCR'}), timeout=10) as r: return r.read(3_000_000)
    except Exception as e: print('Sin foto para', b.get('name'), e)
    return None

def loc_of(b):
    if b.get('prov'): return ', '.join(x for x in (b.get('prov'), b.get('cant'), b.get('dist')) if x)
    return ', '.join(x.strip() for x in (b.get('loc') or '').split(',')[:2] if x.strip())

PAGE = '''<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content="{desc}">
<link rel="canonical" href="{url}">
<meta property="og:type" content="website"><meta property="og:site_name" content="AnunciateCR"><meta property="og:locale" content="es_CR">
<meta property="og:title" content="{title}"><meta property="og:description" content="{desc}"><meta property="og:url" content="{url}">
<meta property="og:image" content="{img}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{alt}">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{title}"><meta name="twitter:description" content="{desc}"><meta name="twitter:image" content="{img}">
<meta name="theme-color" content="#0A1322">
<style>body{{margin:0;background:#0A1322;color:#F1F5F9;font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;text-align:center;padding:20px}}img{{max-width:100%;border-radius:16px}}a{{color:#F2691D;font-weight:700}}p{{color:#94A3B8}}</style>
</head><body><main><img src="card.jpg" alt="{alt}" width="600"><h1>{name}</h1><p>{cat} · {loc}</p><p>{desc}</p>
<p><a href="{app}">Abrir en AnunciateCR</a></p></main>
<script>location.replace("{app}")</script></body></html>
'''

def build(businesses, out=OUT):
    os.makedirs(out, exist_ok=True)
    mf = os.path.join(out, 'manifest.json')
    old = json.load(open(mf)) if os.path.exists(mf) else {}
    new = {}
    for b in businesses:
        bid = b['id']
        if not re.fullmatch(r'[A-Za-z0-9_-]{4,40}', bid): continue
        photo = get_photo(b); loc = loc_of(b)
        key = hashlib.sha1(json.dumps([b.get('name'), b.get('cat'), loc, b.get('desc'), hashlib.sha1(photo or b'').hexdigest()], ensure_ascii=False).encode()).hexdigest()[:10]
        new[bid] = key
        if old.get(bid) == key and os.path.exists(os.path.join(out, bid, 'index.html')): continue
        d = os.path.join(out, bid); os.makedirs(d, exist_ok=True)
        open(os.path.join(d, 'card.jpg'), 'wb').write(make_card(b.get('name') or 'Negocio', b.get('cat') or '', loc, photo))
        name, cat = b.get('name') or 'Negocio', b.get('cat') or ''
        desc = (f"{cat} en {loc}. " if cat and loc else '') + re.sub(r'\s+', ' ', b.get('desc') or 'Conócelo en AnunciateCR y contáctalo por WhatsApp.')
        desc = desc[:160]
        e = html.escape
        open(os.path.join(d, 'index.html'), 'w', encoding='utf-8').write(PAGE.format(
            title=e(f'{name} | AnunciateCR'), desc=e(desc), url=f'{SITE}/n/{bid}/', img=f'{SITE}/n/{bid}/card.jpg?v={key}',
            alt=e(f'{name} en AnunciateCR'), name=e(name), cat=e(cat), loc=e(loc), app=f'{SITE}/#/negocio/{bid}'))
        print('Creada la página de', name)
    for gone in set(old) - set(new):  # negocios que ya no están aprobados
        shutil.rmtree(os.path.join(out, gone), ignore_errors=True); print('Quitada', gone)
    json.dump(new, open(mf, 'w'), indent=0)

if __name__ == '__main__':
    import firebase_admin
    from firebase_admin import credentials, firestore
    firebase_admin.initialize_app(credentials.Certificate(json.loads(os.environ['FIREBASE_SERVICE_ACCOUNT'])))
    db = firestore.client()
    bs = [dict(d.to_dict(), id=d.id) for d in db.collection('businesses').where('status', '==', 'approved').stream()]
    print('Negocios aprobados:', len(bs)); build(bs)
